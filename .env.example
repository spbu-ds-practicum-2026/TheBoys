# PostgreSQL Configuration
POSTGRES_DB=theboys
POSTGRES_USER=theboys_user
POSTGRES_PASSWORD=theboys_secret_pass

# Security Secrets (Generate secure random values for production)
INTERNAL_SECRET=cluster-super-secret-key-32bytes
SESSION_SECRET=session-cookie-secret-key-32bytes

# Application Settings
SESSION_COOKIE_MAX_AGE_SECONDS=86400
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000

# Nginx port binding
NGINX_PORT=80
