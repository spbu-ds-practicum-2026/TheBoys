# ============================================================================
# TheBoys Environment Variables
# Copy to .env and adjust for your local environment: cp .env.example .env
# ============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_DB=theboys
POSTGRES_USER=theboys_user
POSTGRES_PASSWORD=theboys_secret_pass

# --- Security Secrets ---
# IMPORTANT: For production and staging deployments, generate unique 32-byte keys!
# You can generate them with: python -c "import secrets; print(secrets.token_hex(32))"
# In local development mode, default placeholder keys are used if omitted.
INTERNAL_SECRET=cluster-super-secret-key-32bytes
SESSION_SECRET=session-cookie-secret-key-32bytes

# --- Application Node Settings ---
# Session cookie time-to-live in seconds (default: 86400 = 24 hours)
SESSION_COOKIE_MAX_AGE_SECONDS=86400

# Allowed HTTP / WebSocket origins for CORS and Cross-Site WebSocket Hijacking defense
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000

# --- Nginx Reverse Proxy ---
NGINX_PORT=80
